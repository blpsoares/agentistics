[5.787487, "o", "\u001b[H \u001b[K\r\n\u001b[K\u001b[2B\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[34d\u001b[K\u001b[1;2H\u001b[93m▄▀█ █▀▀ █▀▀ █▄░█ ▀█▀ █ █▀ ▀█▀ █ █▀▀ █▀\r\n\u001b[39m \u001b[93m█▀█ █▄█ ██▄ █░▀█ ░█░ █ ▄█ ░█░ █ █▄▄ ▄█\u001b[39m                                                                 \u001b[2mmember · v1.7.3\u001b[4;1H\u001b(B\u001b[m \u001b[2m services \u001b(B\u001b[m \u001b[2m setup \u001b(B\u001b[m \u001b[2m logs \u001b(B\u001b[m \u001b[93m\u001b[1m commands \u001b(B\u001b[m \u001b[2m help \u001b(B\u001b[m \u001b[2m contribute \r\n\u001b(B\u001b[m \u001b[93m                          ━━━━━━━━━━                     \r\n\u001b[39m \u001b[30m╭─ \u001b[2mcommands\u001b(B\u001b[m\u001b[30m ─────────────────────────────────────────────────────────────────────────────────────────────────────────╮\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[2mThe commands worth remembering.\u001b(B\u001b[m                                                                                    \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m                                                                                                                    \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[2mRUN\u001b(B\u001b[m\u001b[30m ──────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop                        \u001b[39m\u001b[2m  open this control center\u001b(B\u001b[m                                                        \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop server                 \u001b[39m\u001b[2m  dashboard + daemon, in this terminal\u001b(B\u001b[m                                            \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop server --bg            \u001b[39m\u001b[2m  same, detached — logs to ~/.agentistics\u001b(B\u001b[m                                         \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop server --port 4000     \u001b[39m\u001b[2m  another port — dashboard on 4001\u001b(B\u001b[m                                                \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop tui                    \u001b[39m\u001b[2m  live metrics in the terminal, no browser\u001b(B\u001b[m                                        \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop watch                  \u001b[39m\u001b[2m  metrics daemon only, headless\u001b(B\u001b[m                                                   \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m                                                                                                                    \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[2mTEAM\u001b(B\u001b[m\u001b[30m ─────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop central up             \u001b[39m\u001b[2m  start the team central (Docker, port 48080)\u001b(B\u001b[m                                     \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop central logs           \u001b[39m\u001b[2m  follow the central's container logs\u001b(B\u001b[m                                             \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop member connect --endpoint <url> --token <token>\u001b[39m                                                          \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[2m  · join a central\u001b(B\u001b[m                                                                                                 \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop member status          \u001b[39m\u001b[2m  mode, endpoint, user and last sync\u001b(B\u001b[m                                              \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  age"]
[5.787678, "o", "ntop member leave           \u001b[39m\u001b[2m  reset this machine back to solo\u001b(B\u001b[m                                                 \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m                                                                                                                    \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[2mMAINTAIN\u001b(B\u001b[m\u001b[30m ─────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop upgrade                \u001b[39m\u001b[2m  install the latest release and restart what was running\u001b(B\u001b[m                         \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop restart --all          \u001b[39m\u001b[2m  bounce every service currently up\u001b(B\u001b[m                                               \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop restart --all --rebuild\u001b[39m\u001b[2m  same, rebuilding first (images, and the binary in a checkout)\u001b(B\u001b[m                   \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop autostart server enable\u001b[39m\u001b[2m  start the server on every boot\u001b(B\u001b[m                                                  \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m                                                                                                                    \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[2m1–22 / 27  ·  hold shift and drag to select and copy\u001b(B\u001b[m                                                               \u001b[30m│\r\n\u001b[39m \u001b[30m╰────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[34;1H\u001b[39m \u001b[2mq quit  ·  ←→ screens  ·  ↑↓/pg scroll  ·  g/G ends  ·  shift+drag to copy  ·  m mouse\u001b(B\u001b[m"]
[10.296334, "o", "\u001b[H\u001b[J \u001b[93m▄▀█ █▀▀ █▀▀ █▄░█ ▀█▀ █ █▀ ▀█▀ █ █▀▀ █▀\r\n\u001b[39m \u001b[93m█▀█ █▄█ ██▄ █░▀█ ░█░ █ ▄█ ░█░ █ █▄▄ ▄█\u001b[39m                                                                 \u001b[2mmember · v1.7.3\u001b[4;1H\u001b(B\u001b[m \u001b[2m services \u001b(B\u001b[m \u001b[2m setup \u001b(B\u001b[m \u001b[2m logs \u001b(B\u001b[m \u001b[93m\u001b[1m commands \u001b(B\u001b[m \u001b[2m help \u001b(B\u001b[m \u001b[2m contribute \r\n\u001b(B\u001b[m \u001b[93m                          ━━━━━━━━━━                     \r\n\u001b[39m \u001b[30m╭─ \u001b[2mcommands\u001b(B\u001b[m\u001b[30m ─────────────────────────────────────────────────────────────────────────────────────────────────────────╮\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[2mThe commands worth remembering.\u001b(B\u001b[m                                                                                    \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m                                                                                                                    \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[2mRUN\u001b(B\u001b[m\u001b[30m ──────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop                        \u001b[39m\u001b[2m  open this control center\u001b(B\u001b[m                                                        \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop server                 \u001b[39m\u001b[2m  dashboard + daemon, in this terminal\u001b(B\u001b[m                                            \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop server --bg            \u001b[39m\u001b[2m  same, detached — logs to ~/.agentistics\u001b(B\u001b[m                                         \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop server --port 4000     \u001b[39m\u001b[2m  another port — dashboard on 4001\u001b(B\u001b[m                                                \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop tui                    \u001b[39m\u001b[2m  live metrics in the terminal, no browser\u001b(B\u001b[m                                        \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop watch                  \u001b[39m\u001b[2m  metrics daemon only, headless\u001b(B\u001b[m                                                   \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m                                                                                                                    \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[2mTEAM\u001b(B\u001b[m\u001b[30m ─────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop central up             \u001b[39m\u001b[2m  start the team central (Docker, port 48080)\u001b(B\u001b[m                                     \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop central logs           \u001b[39m\u001b[2m  follow the central's container logs\u001b(B\u001b[m                                             \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop member connect --endpoint <url> --token <token>\u001b[39m                                                          \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[2m  · join a central\u001b(B\u001b[m                                                                                                 \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop member status          \u001b[39m\u001b[2m  mode, endpoint, user and last sync\u001b(B\u001b[m                                              \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m \u001b[94m  agentop member leave           \u001b[39m\u001b[2m  reset this machine back to solo\u001b(B\u001b[m                                                 \u001b[30m│\r\n\u001b[39m \u001b[30m│\u001b[39m            "]
