[10.208828, "o", "│\r\n\u001b[39m \u001b[38;2;63;63;70m│\u001b[39m \u001b[2m  · join a central\u001b(B\u001b[m                                                                                                 \u001b[38;2;63;63;70m│\r\n\u001b[39m \u001b[38;2;63;63;70m│\u001b[39m \u001b[38;2;99;102;241m  agentop member status          \u001b[39m\u001b[2m  mode, endpoint, user and last sync\u001b(B\u001b[m                                              \u001b[38;2;63;63;70m│\r\n\u001b[39m \u001b[38;2;63;63;70m│\u001b[39m \u001b[38;2;99;102;241m  agentop member leave           \u001b[39m\u001b[2m  reset this machine back to solo\u001b(B\u001b[m                                                 \u001b[38;2;63;63;70m│\r\n\u001b[39m \u001b[38;2;63;63;70m│\u001b[39m                                                                                                                    \u001b[38;2;63;63;70m│\r\n\u001b[39m \u001b[38;2;63;63;70m│\u001b[39m \u001b[2mMAINTAIN\u001b(B\u001b[m\u001b[38;2;63;63;70m ─────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m \u001b[38;2;63;63;70m│\r\n\u001b[39m \u001b[38;2;63;63;70m│\u001b[39m \u001b[38;2;99;102;241m  agentop upgrade                \u001b[39m\u001b[2m  install the latest release and restart what was running\u001b(B\u001b[m                         \u001b[38;2;63;63;70m│\r\n\u001b[39m \u001b[38;2;63;63;70m│\u001b[39m \u001b[38;2;99;102;241m  agentop restart --all          \u001b[39m\u001b[2m  bounce every service currently up\u001b(B\u001b[m                                               \u001b[38;2;63;63;70m│\r\n\u001b[39m \u001b[38;2;63;63;70m│\u001b[39m \u001b[38;2;99;102;241m  agentop restart --all --rebuild\u001b[39m\u001b[2m  same, rebuilding first (images, and the binary in a checkout)\u001b(B\u001b[m                   \u001b[38;2;63;63;70m│\r\n\u001b[39m \u001b[38;2;63;63;70m│\u001b[39m \u001b[38;2;99;102;241m  agentop autostart server enable\u001b[39m\u001b[2m  start the server on every boot\u001b(B\u001b[m                                                  \u001b[38;2;63;63;70m│\r\n\u001b[39m \u001b[38;2;63;63;70m│\u001b[39m                                                                                                                    \u001b[38;2;63;63;70m│\r\n\u001b[39m \u001b[38;2;63;63;70m│\u001b[39m \u001b[2m1–22 / 27  ·  hold shift and drag to select and copy\u001b(B\u001b[m                                                               \u001b[38;2;63;63;70m│\r\n\u001b[39m \u001b[38;2;63;63;70m╰────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[34;1H\u001b[39m \u001b[2mq quit  ·  ←→ screens  ·  ↑↓/pg scroll  ·  g/G ends  ·  shift+drag to copy  ·  m mouse\u001b(B\u001b[m"]
